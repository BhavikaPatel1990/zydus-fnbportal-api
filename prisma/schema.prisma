generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CurrentlyEditing {
  id         String    @id @default(uuid())
  page_id    Int
  user_id    String
  po_id      String
  timestamp  DateTime  @default(now())
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  created_by String?
  updated_by String?
  deleted_by String?
  is_active  Boolean   @default(true)

  @@index([page_id])
}

model DietType {
  id            String         @id @default(uuid())
  diet_type_id  Int            @unique
  diet_name     String
  from_time     DateTime
  to_time       DateTime
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt
  deleted_at    DateTime?
  created_by    String?
  updated_by    String?
  deleted_by    String?
  is_active     Boolean        @default(true)
  patientOrders PatientOrder[] @relation("DietTypeToPatientOrder")

  @@index([diet_type_id])
}

model HinaiOrder {
  id             String         @id @default(uuid())
  patient_id     Int
  mr_no          BigInt
  patient_name   String
  admission_no   String
  admission_at   DateTime
  bed_no         String
  ward           String
  doctor         String
  menu           String
  menu_detail    String
  order_date     DateTime
  time_diff      Int
  diet_type      Int
  order_id       Int            @unique
  status         Boolean
  nurse_remark   String?
  is_discharge   Boolean
  nursing_user   String
  is_diet_change Boolean
  is_transfer    Boolean
  age_gender     String
  mobile_no      String?
  email          String?
  mst_id         BigInt?
  clearance      Boolean?
  out_time       String?
  out_by         String?
  remarks        String?
  clearance_time String?
  clearance_by   String?
  diagnosis      String?
  approved_date  DateTime?
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt
  deleted_at     DateTime?
  created_by     String?
  updated_by     String?
  deleted_by     String?
  is_active      Boolean        @default(true)
  patientOrders  PatientOrder[] @relation("HinaiToPatientOrder")

  @@index([patient_id])
  @@index([mst_id])
  @@index([mst_id, is_discharge, patient_id, order_id(sort: Desc)])
  @@index([mst_id, diet_type])
  @@index([order_date])
}

model Location {
  id                String    @id @default(uuid())
  name              String
  service_center_id Int
  display_order     Int
  is_active_flag    String
  mst_id            Int?
  wing_id           Int
  floor_id          Int
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  deleted_at        DateTime?
  created_by        String?
  updated_by        String?
  deleted_by        String?
  is_active         Boolean   @default(true)

  @@index([mst_id])
}

model MenuTime {
  id                  String               @id @default(uuid())
  description         String
  sort_order          Int                  @default(0)
  created_at          DateTime             @default(now())
  updated_at          DateTime             @updatedAt
  deleted_at          DateTime?
  created_by          String?
  updated_by          String?
  deleted_by          String?
  is_active           Boolean              @default(true)
  patientOrderDetails PatientOrderDetail[] @relation("MenuTimeToOrderDetail")
  patientOrderLiquids PatientOrderLiquid[] @relation("MenuTimeToLiquid")
}

model PatientOrder {
  id              String   @id @default(uuid())
  patient_id      Int
  diet_type       Int
  nursing_remark  String
  diet_remark     String
  dispatched      Boolean?
  dispatched_by   String?
  dispatched_at   DateTime?
  hinai_order_id  Int
  is_cancelled    Boolean?
  liquid_hours    Int
  mst_id         BigInt?
  mail_flag       Int      @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  deleted_at DateTime?
  created_by String?
  updated_by String?
  deleted_by String?
  is_active  Boolean  @default(true)

  hinaiOrder          HinaiOrder           @relation("HinaiToPatientOrder", fields: [hinai_order_id], references: [order_id])
  dietTypeData        DietType             @relation("DietTypeToPatientOrder", fields: [diet_type], references: [diet_type_id])
  patientOrderDetails PatientOrderDetail[] @relation("PoToOrderDetail")
  patientOrderLiquids PatientOrderLiquid[] @relation("PoToLiquid")

  @@index([patient_id])
  @@index([hinai_order_id])
  @@index([diet_type])
}

model PatientOrderDetail {
  id           String       @id @default(uuid())
  po_id        String
  ptm_id       String
  item_id      Int
  remarks      String
  created_at   DateTime     @default(now())
  updated_at   DateTime     @updatedAt
  deleted_at   DateTime?
  created_by   String?
  updated_by   String?
  deleted_by   String?
  is_active    Boolean      @default(true)
  patientOrder PatientOrder @relation("PoToOrderDetail", fields: [po_id], references: [id])
  menuTime     MenuTime     @relation("MenuTimeToOrderDetail", fields: [ptm_id], references: [id])

  @@index([po_id])
  @@index([ptm_id])
}

model PatientOrderLiquid {
  id           String       @id @default(uuid())
  po_id        String
  ptm_id       String?
  liquid_time  Int
  remarks      String
  created_at   DateTime     @default(now())
  updated_at   DateTime     @updatedAt
  deleted_at   DateTime?
  created_by   String?
  updated_by   String?
  deleted_by   String?
  is_active    Boolean      @default(true)
  patientOrder PatientOrder @relation("PoToLiquid", fields: [po_id], references: [id])
  menuTime     MenuTime?    @relation("MenuTimeToLiquid", fields: [ptm_id], references: [id])

  @@index([po_id])
  @@index([ptm_id])
}

model PatientDiagnosis {
  id             String    @id @default(uuid())
  mr_no          String
  patient_id     Int
  diagnosis      String
  hinai_order_id Int
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  deleted_at     DateTime?
  created_by     String?
  updated_by     String?
  deleted_by     String?
  is_active      Boolean   @default(true)

  @@index([patient_id])
}

model StickerPrintStatus {
  id           String    @id @default(uuid())
  patient_id   Int
  po_id        Int
  menu_time_id Int
  print_done   Boolean   @default(false)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  deleted_at   DateTime?
  created_by   String?
  updated_by   String?
  deleted_by   String?
  is_active    Boolean   @default(true)

  @@index([patient_id])
  @@index([po_id])
}
