{
  "info": {
    "_postman_id": "e8f32194-4712-4c28-98bc-7649d63f912a",
    "name": "Zydus FNB External Integration API",
    "description": "Postman API Collection for external software/systems to insert and update patient orders, nursing remarks, transfers, discharges, patient statuses, and inpatient census data directly into Zydus FNB Portal database.\n\n### Authentication\nAll requests require a Bearer token in the `Authorization` header. Set your token in the `jwt_token` collection variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. HINAI Data Sync & Upsert (Bulk & Single)",
      "item": [
        {
          "name": "1.1 Upsert HINAI Orders (Bulk Payload)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orders\": [\n    {\n      \"HINAIORDERID\": 61639970,\n      \"PATIENT_ID\": 1346560,\n      \"MRNO\": \"10002026563660\",\n      \"PATIENT\": \"Mrs SAKINABEN ZULFIKAR AGHARIYA\",\n      \"ADMISSIONNUMBER\": \"AD1000260401482\",\n      \"ADMDATE\": \"2026-04-21 15:02:00\",\n      \"BED_NO\": \"ICU6B_02\",\n      \"SCNAME\": \"ICU6D - 6F\",\n      \"DOCTOR\": \"Dr. RAJESH DESAI\",\n      \"MENU\": \"FULL DIET\",\n      \"NAME\": \"FULL DIET, SALT RESTRICTED DIET\",\n      \"CDATE\": \"2026-04-21 08:00:00\",\n      \"DIFF\": 1,\n      \"DIETTYPE\": 17129492,\n      \"APPROVEDDATE\": \"2026-04-21 08:01:52\",\n      \"SITEID\": 2,\n      \"USERNAME\": \"AJAY JANGID\",\n      \"ISDIETCHANGED\": 0,\n      \"NURSEREMARK\": \"0\",\n      \"DIAGNOSIS\": \"0\",\n      \"AGEGENDER\": \"78 Years/F\",\n      \"MOBILENO\": \"9377249099\",\n      \"EMAIL\": \"ARYAMNKESHD@GMAIL.COM\",\n      \"PLAN_NAME\": \"Cash\"\n    },\n    {\n      \"HINAIORDERID\": 61639971,\n      \"PATIENT_ID\": 1346561,\n      \"MRNO\": \"10002026563661\",\n      \"PATIENT\": \"Mr RAMESH PATEL\",\n      \"ADMISSIONNUMBER\": \"AD1000260401483\",\n      \"ADMDATE\": \"2026-04-21 16:00:00\",\n      \"BED_NO\": \"ICU6B_03\",\n      \"SCNAME\": \"ICU6D - 6F\",\n      \"DOCTOR\": \"Dr. AMIT SHAH\",\n      \"MENU\": \"SOFT DIET\",\n      \"NAME\": \"SOFT DIET\",\n      \"CDATE\": \"2026-04-21 08:30:00\",\n      \"DIFF\": 1,\n      \"DIETTYPE\": 17129492,\n      \"APPROVEDDATE\": \"2026-04-21 08:35:00\",\n      \"SITEID\": 2,\n      \"USERNAME\": \"AJAY JANGID\",\n      \"ISDIETCHANGED\": 0,\n      \"NURSEREMARK\": \"0\",\n      \"DIAGNOSIS\": \"0\",\n      \"AGEGENDER\": \"65 Years/M\",\n      \"MOBILENO\": \"9898012345\",\n      \"EMAIL\": \"RAMESH@GMAIL.COM\",\n      \"PLAN_NAME\": \"Insurance\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{fnb_url}}/ipd/hinaiorders/upsert",
              "host": [
                "{{fnb_url}}"
              ],
              "path": [
                "ipd",
                "hinaiorders",
                "upsert"
              ]
            },
            "description": "Insert or update HINAI orders in bulk. Accepts object with `orders` array, raw JSON array `[...]`, or single order object."
          },
          "response": []
        },
